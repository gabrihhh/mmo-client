[gd_resource type="Theme" load_steps=4 format=3]

; Tema da interface do jogo (telas de login, HUD...). Ver mmo-docs [CLI-07].
; Campos de texto: cantos arredondados e espaço interno para o texto/placeholder não encostar na borda.

[sub_resource type="StyleBoxFlat" id="LineEdit_normal"]
content_margin_left = 24.0
content_margin_top = 12.0
content_margin_right = 24.0
content_margin_bottom = 12.0
bg_color = Color(0.08, 0.1, 0.14, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.3, 0.36, 0.45, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[sub_resource type="StyleBoxFlat" id="LineEdit_focus"]
content_margin_left = 24.0
content_margin_top = 12.0
content_margin_right = 24.0
content_margin_bottom = 12.0
draw_center = false
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.85, 0.6, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[sub_resource type="StyleBoxFlat" id="LineEdit_read_only"]
content_margin_left = 24.0
content_margin_top = 12.0
content_margin_right = 24.0
content_margin_bottom = 12.0
bg_color = Color(0.08, 0.1, 0.14, 0.6)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.3, 0.36, 0.45, 0.6)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[resource]
LineEdit/colors/font_placeholder_color = Color(1, 1, 1, 0.4)
LineEdit/styles/normal = SubResource("LineEdit_normal")
LineEdit/styles/focus = SubResource("LineEdit_focus")
LineEdit/styles/read_only = SubResource("LineEdit_read_only")
